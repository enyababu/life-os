<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Life OS | My Personal Space</title>

  <style>
    :root {
      --background: #f8f5f2;
      --surface: rgba(255,255,255,0.78);
      --text: #433d3b;
      --muted: #938783;
      --accent: #c9a8a3;
      --border: rgba(194,170,164,0.22);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--background);
      color: var(--text);
    }

    .app {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 245px;
      flex-shrink: 0;
      background: rgba(255,255,255,0.65);
      border-right: 1px solid var(--border);
      padding: 35px 22px;
    }

    .logo {
      font-family: Georgia, serif;
      font-size: 29px;
      margin-bottom: 45px;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-item {
      display: block;
      width: 100%;
      padding: 14px;
      margin-bottom: 8px;
      border: 0;
      border-radius: 13px;
      background: transparent;
      color: var(--text);
      text-align: left;
      font-size: 14px;
      cursor: pointer;
    }

    .nav-item.active {
      background: #f0e5e2;
    }

    .nav-item:hover {
      background: #f4ece9;
    }

    main {
      flex: 1;
      padding: 50px;
      max-width: 1500px;
      margin: 0 auto;
    }

    .greeting {
      font-family: Georgia, serif;
      font-size: 38px;
      font-weight: normal;
      margin: 0;
    }

    .date {
      color: var(--muted);
      margin-top: 12px;
    }

    .dashboard {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      margin-top: 40px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 28px;
      box-shadow: 0 12px 35px rgba(90,65,60,0.035);
      backdrop-filter: blur(16px);
      min-height: 220px;
    }

    .card h2 {
      font-family: Georgia, serif;
      font-size: 22px;
      font-weight: normal;
      margin: 0 0 22px;
    }

    .muted {
      color: var(--muted);
      font-size: 14px;
    }

    .input-row {
      display: flex;
      gap: 10px;
      margin-top: 18px;
    }

    input, textarea {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: #fff;
      padding: 12px;
      font: inherit;
      color: var(--text);
    }

    textarea {
      min-height: 130px;
      resize: vertical;
    }

    button.add {
      background: var(--accent);
      color: white;
      border: 0;
      border-radius: 11px;
      padding: 12px 18px;
      cursor: pointer;
    }

    .task {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }

    .task input {
      width: auto;
      accent-color: var(--accent);
    }

    .task.done span {
      text-decoration: line-through;
      color: var(--muted);
    }

    .task span {
      flex: 1;
      overflow-wrap: anywhere;
    }

    .delete {
      border: 0;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 18px;
    }

    .wide {
      grid-column: 1 / -1;
    }

    @media (max-width: 850px) {
      .sidebar {
        width: 190px;
      }

      main {
        padding: 28px;
      }

      .dashboard {
        grid-template-columns: 1fr;
      }

      .wide {
        grid-column: auto;
      }
    }

    @media (max-width: 600px) {
      .app {
        display: block;
      }

      .sidebar {
        width: 100%;
        padding: 18px;
      }

      .logo {
        margin-bottom: 15px;
      }

      main {
        padding: 22px;
      }

      .greeting {
        font-size: 30px;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <aside class="sidebar">
    <div class="logo">life<span>OS.</span></div>

    <nav>
      <button class="nav-item active">⌂ &nbsp; Dashboard</button>
      <button class="nav-item">▦ &nbsp; Planner</button>
      <button class="nav-item">✓ &nbsp; Tasks</button>
      <button class="nav-item">✧ &nbsp; Brain Dump</button>
      <button class="nav-item">◫ &nbsp; Projects</button>
      <button class="nav-item">♡ &nbsp; Habits</button>
      <button class="nav-item">⚙ &nbsp; Settings</button>
    </nav>
  </aside>

  <main>

    <h1 class="greeting" id="greeting">Good morning ☁️</h1>
    <p class="date" id="date"></p>

    <section class="dashboard">

      <div class="card">
        <h2>☀️ Today's Focus</h2>
        <p class="muted">What matters most today?</p>
        <textarea id="focus" placeholder="Dein heutiger Fokus ..."></textarea>
      </div>

      <div class="card">
        <h2>✓ My Tasks</h2>
        <div id="taskList"></div>

        <div class="input-row">
          <input id="taskInput" placeholder="Neue Aufgabe ...">
          <button class="add" id="addTask">+</button>
        </div>
      </div>

      <div class="card wide">
        <h2>✧ Brain Dump</h2>
        <p class="muted">A safe space for all your thoughts.</p>
        <textarea id="brainDump" placeholder="Was geht dir gerade durch den Kopf?"></textarea>
      </div>

    </section>

  </main>

</div>

<script>
  const today = new Date();
  const hour = today.getHours();

  document.getElementById("greeting").textContent =
    hour < 11 ? "Good morning ☁️" :
    hour < 17 ? "Good afternoon ☀️" :
    "Good evening 🌙";

  document.getElementById("date").textContent =
    today.toLocaleDateString("de-CH", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric"
    });

  const KEY = "life-os-v1";

  let data = {
    tasks: [],
    focus: "",
    brainDump: ""
  };

  try {
    const saved = JSON.parse(localStorage.getItem(KEY));

    if (saved && typeof saved === "object") {
      data = {
        tasks: Array.isArray(saved.tasks) ? saved.tasks : [],
        focus: saved.focus || "",
        brainDump: saved.brainDump || ""
      };
    }
  } catch (error) {
    console.warn("Gespeicherte Daten konnten nicht geladen werden.");
  }

  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify(data));
    } catch (error) {
      console.warn("Speichern im Browser fehlgeschlagen.");
    }
  }

  const focusInput = document.getElementById("focus");
  const brainInput = document.getElementById("brainDump");
  const taskInput = document.getElementById("taskInput");
  const taskList = document.getElementById("taskList");

  focusInput.value = data.focus;
  brainInput.value = data.brainDump;

  focusInput.addEventListener("input", () => {
    data.focus = focusInput.value;
    save();
  });

  brainInput.addEventListener("input", () => {
    data.brainDump = brainInput.value;
    save();
  });

  function renderTasks() {
    taskList.replaceChildren();

    if (data.tasks.length === 0) {
      const empty = document.createElement("p");
      empty.className = "muted";
      empty.textContent = "Noch keine Aufgaben vorhanden.";
      taskList.appendChild(empty);
    }

    data.tasks.forEach((task, index) => {
      const row = document.createElement("div");
      row.className = "task" + (task.done ? " done" : "");

      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = task.done;

      checkbox.addEventListener("change", () => {
        data.tasks[index].done = checkbox.checked;
        save();
        renderTasks();
      });

      const label = document.createElement("span");
      label.textContent = task.text;

      const remove = document.createElement("button");
      remove.className = "delete";
      remove.textContent = "×";
      remove.setAttribute("aria-label", "Aufgabe löschen");

      remove.addEventListener("click", () => {
        data.tasks.splice(index, 1);
        save();
        renderTasks();
      });

      row.append(checkbox, label, remove);
      taskList.appendChild(row);
    });
  }

  function addTask() {
    const text = taskInput.value.trim();

    if (!text) return;

    data.tasks.push({
      text,
      done: false
    });

    taskInput.value = "";
    save();
    renderTasks();
    taskInput.focus();
  }

  document.getElementById("addTask")
    .addEventListener("click", addTask);

  taskInput.addEventListener("keydown", event => {
    if (event.key === "Enter") addTask();
  });

  renderTasks();
</script>

</body>
</html>
